{
  "name": "9router-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unit tests for 9router embeddings endpoint",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:rotation": "node --require ./rotation/block-outbound.cjs --loader ./rotation/loader.mjs --test --test-force-exit ./rotation/*.test.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
